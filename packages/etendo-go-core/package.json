{
  "name": "@etendosoftware/etendo-go-core",
  "version": "0.3.0",
  "description": "Core onboarding, auth flow, and shared components for Etendo GO — consumed by all locale workspaces.",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": "./src/index.js",
    "./onboarding": "./src/onboarding/index.js",
    "./onboarding/api": "./src/onboarding/api.js",
    "./onboarding/sso": "./src/onboarding/sso.js",
    "./onboarding/state": "./src/onboarding/state.js",
    "./onboarding/password-policy": "./src/onboarding/passwordPolicy.js",
    "./onboarding/oauth-return-to": "./src/onboarding/oauthReturnTo.js",
    "./onboarding/field-limits": "./src/onboarding/fieldLimits.js",
    "./onboarding/error-messages": "./src/onboarding/errorMessages.js"
    ,"./checkout": "./src/checkout/index.js"
  },
  "files": [
    "src",
    "!src/**/__tests__/**"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:vitest": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.0.0"
  }
}
